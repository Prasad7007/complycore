# Database Configuration (AWS RDS)
DATABASE_URL=postgresql://user:password@rds-endpoint:5432/ai_compliance?sslmode=require

# Security
SECRET_KEY=your_secure_secret_key_here
APP_ENV=development

# Session cookie (httpOnly access token). Defaults are safe for production behind one
# origin (nginx serving SPA + proxying /api/v1 to FastAPI).
# ACCESS_TOKEN_COOKIE_NAME=ac_session
# ACCESS_TOKEN_COOKIE_PATH=/api/v1
# ACCESS_TOKEN_COOKIE_SAMESITE=lax            # use "none" only across registrable domains (then COOKIE_SECURE=true and add CSRF)
# ACCESS_TOKEN_COOKIE_DOMAIN=                 # leave empty for host-only cookie
# COOKIE_SECURE=                              # defaults to true when APP_ENV=production, false otherwise

# CORS: comma-separated extra origins beyond local dev defaults. Use full origins (scheme + host[:port]).
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# AES-256-GCM at-rest encryption (base64 of 32 random bytes). Optional in dev; required in
# production for fields routed through apis.core.at_rest_crypto. Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# DATA_ENCRYPTION_KEY=

# AWS Configuration
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Frontend origin for email CTAs and hosted assets (no trailing slash).
FRONTEND_BASE_URL=http://localhost:5173

# AWS SES Configuration (Email)
# Application-sent mail (MFA OTP, mentions, etc.) uses SES only via this identity.
SES_SOURCE_EMAIL=verified_sender@example.com

# Email header logo (defaults to S3 when unset — works in Gmail for local/UAT/prod).
# EMAIL_LOGO_URL=https://comply-core-assets.s3.ca-central-1.amazonaws.com/complycore-logo.png
# Optional: use SPA static file instead of S3 (localhost will not show in Gmail).
# EMAIL_LOGO_USE_FRONTEND=true

# OTP_EXPIRE_MINUTES=1
# PASSWORD_RESET_OTP_EXPIRE_MINUTES=10

# AWS Cognito Configuration
# Sign-up verification and forgot-password codes are emailed by the user pool.
# In the Cognito console, configure the pool to send email with Amazon SES
# (recommended: same region and verified identities as above), not custom SMTP.
COGNITO_USER_POOL_ID=your_user_pool_id_here
COGNITO_APP_CLIENT_ID=your_app_client_id_here

# Demo login bypass (dev only; do not enable in production)
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_PASSWORD=password123
DEMO_LOGIN_EMAILS=marketing@company.com,sme@company.com,compliance@company.com,superadmin@company.com,profile@company.com

