# Worker: Docling, LibreOffice, LLM pipeline, Celery.
# Multi-stage build — compilers only in builder; CPU PyTorch in runtime.
# Dependencies installed with uv (faster than pip) in the builder stage.

FROM python:3.11-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.6.17 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

ARG INSTALL_MIGRATION_TOOLS=false

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements_migrations.txt ./

# Exclude Windows-only and CUDA torch; install CPU wheels first, then the rest into /install.
# After install, delete the rogue PyPI `pathlib` package (installed as a transitive dep of pyxnat)
# which ships a pathlib.py using `from collections import Sequence` — removed in Python 3.10+.
# Python 3.4+ has pathlib built-in; the PyPI shim must never shadow it.
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v "^pywin32==" requirements.txt | grep -v "^pathlib==" | grep -v "^dotenv==" | grep -v -E '^(torch|torchvision)==' > /tmp/requirements.docker.txt && \
    echo "celery==5.4.0" >> /tmp/requirements.docker.txt && \
    echo "redis==5.2.1" >> /tmp/requirements.docker.txt && \
    uv pip install --prefix=/install \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.10.0 torchvision==0.25.0 && \
    uv pip install --prefix=/install -r /tmp/requirements.docker.txt && \
    if [ "${INSTALL_MIGRATION_TOOLS}" = "true" ]; then \
        uv pip install --prefix=/install -r requirements_migrations.txt; \
    fi && \
    rm -f /install/lib/python3.11/site-packages/pathlib.py && \
    rm -rf /install/lib/python3.11/site-packages/pathlib-*.dist-info


FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/install/bin:$PATH" \
    PYTHONPATH="/install/lib/python3.11/site-packages:${PYTHONPATH:-}"

WORKDIR /app

# Runtime system libs only (no build-essential).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libgl1 \
    libglib2.0-0 \
    libxcb1 \
    libxrender1 \
    libxext6 \
    libsm6 \
    libjpeg62-turbo \
    zlib1g \
    libreoffice-common \
    libreoffice-core \
    libreoffice-impress \
    libreoffice-writer \
    python3-uno \
    ure \
    fonts-dejavu \
    fonts-liberation \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /install

COPY . .

# Recycle child processes after heavy Docling/LLM tasks to limit memory fragmentation.
# worker_max_tasks_per_child is set in celery_app.conf (CELERY_MAX_TASKS_PER_CHILD).
CMD ["python", "-m", "celery", "-A", "apis.services.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
