# Copy to loadtest/.env (gitignored) or export on EC2 before running Locust.

# Full API prefix including /api/v1
# - Locust on your laptop → public UAT URL: https://uat.example.com/api/v1
# - Locust in Docker on same EC2 as the app → http://api:8052/api/v1 (compose network)
# - Locust container with --network host → http://127.0.0.1:8052/api/v1
UAT_BASE_URL=https://your-uat-host.example.com/api/v1

# Long-lived JWT or service token (marketing role required for upload)
AUTH_TOKEN=

# Tenant org slug from the app URL (/orgs/<slug>/...)
ORG_SLUG=legacy-default

# PDF used for every virtual user upload
FIXTURE_PDF_PATH=./fixtures/sample.pdf

# Poll GET .../review until ai_analysis_state is completed or failed
POLL_INTERVAL_SEC=5
ANALYSIS_TIMEOUT_SEC=1800

DOCUMENT_TYPE=Marketing Material

# Direct-to-marketing so Celery queues analysis (default SME routing never starts a scan)
UPLOAD_ROUTING=marketing
